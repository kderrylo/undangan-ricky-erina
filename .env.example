# ============================================================
# Salin file ini menjadi .env (untuk local dev) atau isi sebagai
# Environment Variables di platform hosting kamu (Vercel/VPS/dsb).
# JANGAN commit file .env asli ke git.
# ============================================================

# --- Koneksi MySQL (Aiven for MySQL) ---
# Didapat dari Aiven console -> Service -> Overview -> Connection information
MYSQL_HOST=your-service-name.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-aiven-password
MYSQL_DATABASE=defaultdb

# Isi dengan seluruh isi file ca.pem yang diunduh dari Aiven console
# (Service -> Overview -> tombol "CA Certificate"). Tempel apa adanya,
# boleh multi-baris atau pakai literal \n.
MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Alternatif cepat untuk development jika CA belum ditempel (TIDAK
# direkomendasikan untuk production karena tidak memverifikasi sertifikat):
# MYSQL_SSL=true

# --- Autentikasi dashboard admin ---
# String acak & panjang untuk menandatangani session token (JWT).
# Generate contoh: openssl rand -base64 48
ADMIN_JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Token rahasia sekali pakai untuk membuat admin PERTAMA lewat
# POST /api/admin/setup. Ganti ke string acak, lalu hapus/rotate
# setelah admin pertama berhasil dibuat.
ADMIN_SETUP_TOKEN=ganti-dengan-token-rahasia
